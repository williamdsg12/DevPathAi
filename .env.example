# ============================================================
# DEVPATH AI — Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env.local e preencha suas credenciais
# ============================================================

# Supabase (Banco de Dados, Autenticação, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Provedor de IA (Gemini, OpenAI, Anthropic ou DeepSeek)
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-pro

# YouTube Data API v3 (Opcional - suporte a feeds públicos integrado sem chave)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Configurações da Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development